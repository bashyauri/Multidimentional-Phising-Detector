# Ignore Python virtual environments
.venv/
.venv-gpu/

# Ignore model weights and large binaries
models/*.pt
models/*.pth
models/*.h5
models/*.ckpt
models/*.pkl

# Ignore backup git directories (too large to push)
backup-Multidimentional-Phising-Detector.git/

# Local database/runtime files
database/*.db

# Ignore all CSV files (datasets are too large)
*.csv
datasets/*.csv
datasets/faceforensics/*.csv
datasets/faceforensics/features_video_classical_cnn.csv
datasets/faceforensics/features_video_combined.csv

# Large licensed deepfake media should stay local.
datasets/faceforensics/original/**
datasets/faceforensics/manipulated/**
datasets/faceforensics/frames/**
!datasets/faceforensics/original/.gitkeep
!datasets/faceforensics/manipulated/.gitkeep
!datasets/faceforensics/frames/.gitkeep

# Large QR image datasets should stay local.
datasets/qr/**/benign_qr_images_500/**
datasets/qr/**/malicious_qr_images_500/**
datasets/qrcode/**
!datasets/qr/**/.gitkeep

# Python cache
__pycache__/
*.py[cod]

# Ignore backup git directories
backup-Multidimentional-Phising-Detector.git/
# Ignore pickle models
models/*.pkl